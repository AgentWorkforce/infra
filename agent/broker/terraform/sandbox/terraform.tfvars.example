# Copy to terraform.tfvars (gitignored). No secrets here. These are the values
# for layered-infra-ops (dev): its default AWS profile is its admin role in the
# broker account, so broker_profile stays unset.
broker_account_id    = "500268966557"
broker_host_role_arn = "arn:aws:iam::500268966557:role/layered-agent-infra-ops-dev"
sandbox_account_id   = "805532413586"
# From ../bootstrap-sandbox (output bootstrap_role_arn): trusts only infra-ops' admin role.
sandbox_assume_role_arn = "arn:aws:iam::805532413586:role/layered-infra-ops-broker-tf"
