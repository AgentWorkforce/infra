# Copy to terraform.tfvars (gitignored). No secrets here.
# The dev account: allowed_account_ids stops a run with the wrong profile before it changes anything.
dev_account_id = "<the dev account id, from broker/allowlist.json>"
# From ../sandbox (output broker_role_arn): the broker role, the only principal the new role trusts.
broker_role_arn = "arn:aws:iam::<broker account id>:role/agent-cred-broker"
# cluster_name = "agent-relay-dev"
# profile      = "<AWS CLI profile with IAM and EKS rights in the dev account>"
