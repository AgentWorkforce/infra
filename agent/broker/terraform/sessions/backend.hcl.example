# Copy to backend.hcl (gitignored) and run: terraform init -backend-config=backend.hcl
# Use a versioned, private S3 bucket in the sessions account that you already own.
# State holds no secrets (a role and its policies; the function's environment is never read).
bucket       = "<state bucket in the sessions account>"
key          = "aws-cred-broker/sessions.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true
