account_id           = "000000000000" # the EKS cluster's account
region               = "us-west-2"
eks_cluster_name     = "example-cluster"
namespace            = "example-namespace"
role_name            = "example-sessions-worker"
sessions_bucket_arn  = "arn:aws:s3:::<sessions bucket in the other account>"
sessions_kms_key_arn = "arn:aws:kms:us-east-1:<other account>:key/<key id>"
