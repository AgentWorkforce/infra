[Unit]
Description=Fetch Relay Chief slot credentials into tmpfs
After=network-online.target
Wants=network-online.target
Before=relay-chief.service

[Service]
Type=oneshot
RemainAfterExit=yes
RuntimeDirectory=relay-chief
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/sbin/relay-chief-fetch-credentials
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
