# Actors arm at relaycast main 10e93f94 (#652/#653/#655/#656) on infra main
# a01566c3 (#274). Images: publish-actors-images run 43350514591
# (tag 12.8.0-actors.1) when available, else self-built from 10e93f94.
# DURABLE_ACTORS_SOCKET_ORIGIN (#655): the gateway dials actor sockets through
# the in-cluster control-plane Service instead of durable-actors.publicUrl, so
# realtime works without public DNS (replaces bench/relaycast/infra/actors-ingress.sh).
relaycast:
  extraEnv:
    - {name: DURABLE_ACTORS_SOCKET_ORIGIN, value: "http://agent-relay-durable-actors.arm-actors.svc.cluster.local:7100"}
  runtime:
    durableActors:
      gateway:
        image:
          repository: ${GATEWAY_REPO}
          digest: ${GATEWAY_DIGEST}
      deployer:
        image:
          repository: ${DEPLOYER_REPO}
          digest: ${DEPLOYER_DIGEST}
