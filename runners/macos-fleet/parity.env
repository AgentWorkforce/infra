# Toolchain the fleet must match before a Mac takes a job. Keep in step with
# the hosted image the routed lanes assume (GitHub macos-15 image: Xcode 16.4
# default, build 16F6). A Mac whose check fails never mints a runner.
# The Xcode version and build are exact; macOS only has to be new enough to
# run that Xcode (fleet Macs track current macOS, the hosted image does not).
EXPECTED_ARCH=arm64
EXPECTED_MACOS_MIN_MAJOR=15
EXPECTED_XCODE_VERSION=16.4
EXPECTED_XCODE_BUILD=16F6
DEVELOPER_DIR=/Applications/Xcode_16.4.app/Contents/Developer
