<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.agentworkforce.fleet-runner.__SLOT__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/fleet-runner/fleet-runner-supervisor.sh</string>
    <string>__SLOT__</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/var/log/fleet-runner/__SLOT__.launchd.log</string>
  <key>StandardErrorPath</key><string>/var/log/fleet-runner/__SLOT__.launchd.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
